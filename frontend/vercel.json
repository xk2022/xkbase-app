{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "_comment": "⚠️ 重要：此檔案中的 /xkBase/ 路徑必須與 src/shared/config/path.config.ts 中的 APP_BASE_PATH 保持一致。如需修改 base path，請同時更新兩個檔案。",
  "rewrites": [
    {
      "source": "/xkBase/(.*)",
      "destination": "/xkBase/index.html"
    },
    {
      "source": "/xkBase",
      "destination": "/xkBase/index.html"
    }
  ],
  "headers": [
    {
      "source": "/xkBase/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
